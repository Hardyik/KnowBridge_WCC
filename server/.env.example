# Server environment — copy to .env and fill in.
# NEVER commit real .env files (already gitignored).

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon key (used to validate client JWTs)
SUPABASE_ANON_KEY=
# service role key — server only, never sent to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Groq (console.groq.com -> API Keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server
PORT=4000
# Origin of the web client (CORS)
CORS_ORIGIN=http://localhost:5173
