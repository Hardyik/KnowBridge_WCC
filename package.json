{
  "name": "knowbridge",
  "version": "0.2.0",
  "private": true,
  "description": "KnowBridge — evidence-linked, permission-aware knowledge handover (Fallen Crows, Round 2)",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "cors": "^2.8.6"
  }
}
